-
-    // =========================================================================
-    // Stage 1: 目標總衰減 T (1/16 dB)
-    //   Linear : T = 1545 + linear_offset - rx_att_index x 160 + pf - offs + algo x 16
-    //   Manual : T = dac_ref + goal_rel + 800 - target x 16 + manual_offset - offs + algo x 16

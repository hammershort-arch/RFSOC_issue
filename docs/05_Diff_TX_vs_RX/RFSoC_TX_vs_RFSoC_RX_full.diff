@@ -1,53 +0,0 @@
-#include "rfdc.h"
-#include "gpio.h"
-#include <xil_printf.h>
-#include <xparameters.h>
-#include "bram.h"
-#include "register_map.h"
-#include "adcThresholds.h"
-
-XRFdc RFdcInst;     // adcThresholds.c 以 extern 使用
-static XGpioPs GpioPsInst;
-
-int main()
-{
-    print("Start LMK04828 Synchronization for XCZU47DR\n\r");
-
-    // Init
-    if (rfdc_dev_init(XPAR_XRFDC_0_BASEADDR, &RFdcInst) != XST_SUCCESS)
-        return XST_FAILURE;
-    print("RF ADC/DAC init completed.\n\r");
-    
-    if (gpio_emio_init(XPAR_XGPIOPS_0_BASEADDR, &GpioPsInst) != XST_SUCCESS)
-        return XST_FAILURE;
-    print("GPIO EMIO init completed.\n\r");
-
-    // BRAM initialization - Gain offset table (ch1 ~ ch8), 寫入後讀回比對
-    gain_offset_tabel_initialize();
-
-    // Register Map: system + ch1 ~ ch8 (PJ22045_1R8T), 初始值見 sources/reg_map_cfg.c
-    register_map_init();
-
-    // ADC threshold (RXAGC over_threshold1 / 2): ch1 ~ ch8 = ADC tile0~3 block0/1
-    adcInitThresh();
-
-    // Reset
-    if (rfdc_reset_dc(&RFdcInst) != XRFDC_SUCCESS)
-        return XST_FAILURE;
-    gpio_handshake(&GpioPsInst);
-
-    // MTS
-    if (rfdc_mts_exec(&RFdcInst) != XRFDC_SUCCESS)
-        return XST_FAILURE;
-    gpio_handshake(&GpioPsInst);
-
-    // MBS
-    if (rfdc_mbs_prep(&RFdcInst) != XRFDC_SUCCESS)
-        return XST_FAILURE;
-    gpio_handshake(&GpioPsInst);
-
-    
-
-    // Return
-    return XST_SUCCESS;
-}

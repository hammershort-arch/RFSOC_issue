-        XRFdc_SetThresholdSettings(RFdcInstPtr, cmd[0], cmd[1], &Threshold_0_Settings);
-        XRFdc_SetThresholdSettings(RFdcInstPtr, cmd[0], cmd[1], &Threshold_1_Settings);
-        adcGetThresh(&cmd[0]);
-    }

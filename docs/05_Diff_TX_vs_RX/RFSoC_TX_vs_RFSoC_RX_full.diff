-                        agc_mode       <= mode_target;
-                        agc_mode_valid <= 1'b1;
-                        mode_change    <= 1'b0;
-                        curr_state     <= S_IDLE;
-                    end else begin
-                        timer <= timer + 1'b1;
-                    end
-                end
-
-                default: curr_state <= S_INIT;
-            endcase
-        end
-    end
-
-endmodule
